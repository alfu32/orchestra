            "text": {
                "initialization": "",
                "initializationLanguageId": "kotlin",
                "source": "val packet = input_record.pop()\nif( packet != null ){\n  val validated = WorkOrderConfirmation(packet,true)\n  out_record.add(validated)\n  \n}",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
