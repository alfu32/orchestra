                    "name": "out",
                    "direction": "Output",
                    "dataType": "",
                    "metadata": {}
                },
                {
                    "id": "input_in",
                    "name": "in",
                    "direction": "Input",
                    "dataType": "",
                    "metadata": {}
                }
            ],
            "link": null,
            "metadata": {},
            "pluginData": {}
        },
