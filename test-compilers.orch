                "initialization": "new Fs()",
                "initializationLanguageId": "",
                "source": "class Fs{\n  filesystem={\n    \"source\":\"a,b,c,d,e\\nf,g,h,i,j\"\n  }\n  read(filename){\n    return this.filesystem[filename]\n  }\n  write(filename,content){\n    this.filesystem[filename] = content\n  }\n  append(filename,content){\n    this.filesystem[filename] = (this.filesystem[filename]||\"\")+content\n  }\n}",
