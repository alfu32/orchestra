            "text": {
                "initialization": "transform_data(input_record,out_record,lib_error_logging2)",
                "initializationLanguageId": "",
                "source": "function transform_data(input_record,out_record,lib_error_logging2){\n    const packet = input_record.pop()\n    if( packet != null ){\n      const validated = new WorkOrderConfirmation(packet,true)\n      out_record.add(validated)\n    }\n}",
