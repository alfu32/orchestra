            },
            "text": {
                "initialization": "val canRead=true\nval filename = \"out.file\"",
                "initializationLanguageId": "kotlin",
                "source": "val packet = out_record.pop()\nif( packet != null ){\n  val line = listOf(\n    packet.workOrder.id,\n    packet.workOrder.name,\n    packet.workOrder.encodingDate,\n    packet.workOrder.numberOfItems,\n    packet.is_confirmed,\n  ).joinTostring(\",\")\n  File.append(filename,line)\n}",
                "sourceLanguageId": "kotlin",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
