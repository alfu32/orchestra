            },
            "text": {
                "initialization": "read_file(input_record,out_record,lib_config1,lib_error_logging1,lib_file3)",
                "initializationLanguageId": "",
                "source": "function read_file(input_record,out_record,lib_config1,lib_error_logging1,lib_file3){\n    const fileContent = lib_file3.read(filename)\n    const rows = fileContent.split(\"\\n\")\n    rows.forEach( row => {\n      const dataList = row.split(\",\")\n      const item = WorkOrder(\n        numberOfItems=dataList[0],\n        encodingDate=dataList[1],\n        name=dataList[2],\n        id=dataList[3],\n      )\n      input_record.add(item)\n    })\n}\n",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
