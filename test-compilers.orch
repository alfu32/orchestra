            "layout": {
                "x": -557.0,
                "y": 838.0,
                "width": 284.0,
                "height": 138.0
            },
            "text": {
                "initialization": "val canRead=true\nval filename = \"in.file\"\n",
                "initializationLanguageId": "kotlin",
                "source": "val fileContent = File.read(filename)\nval rows = fileContent.split(\"\\n\")\nrows.forEach{ row ->\n  val dataList = row.split(\",\")\n  val item = WorkOrder(\n    numberOfItems=dataList[0],\n    encodingDate=dataList[1],\n    name=dataList[2],\n    id=dataList[3],\n  )\n  input_record.add(item)\n}",
                "sourceLanguageId": "kotlin",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "kotlin",
                "technologyId": "kotlin-jvm",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
