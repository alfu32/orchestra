            "text": {
                "initialization": "write_response_file(out_record,lib_file4,lib_error_logging3,lib_config2)",
                "initializationLanguageId": "",
                "source": "function write_response_file(out_record,lib_file4,lib_error_logging3,lib_config2){\n    const packet = out_record.pop()\n    if( packet != null ){\n      const line = [\n        packet.workOrder.id,\n        packet.workOrder.name,\n        packet.workOrder.encodingDate,\n        packet.workOrder.numberOfItems,\n        packet.is_confirmed,\n      ].join(\",\")\n      lib_file4.append(\"outfile\",line)\n    }\n}",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
