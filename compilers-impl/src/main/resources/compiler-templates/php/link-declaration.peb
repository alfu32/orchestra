{# Each data link owns two FIFO arrays and a transport function. #}
{% if link.stereotype == "DependencyInjection" %}/** @var {{ link.sourceNodeTypeSymbol }} ${{ link.dependencySymbol }} */
${{ link.dependencySymbol }} = {% if link.libraryInstantiation is not empty %}{{ link.libraryInstantiation }}{% else %}null{% endif %};
{% elseif link.stereotype != "UsageImport" %}/** @var array<int, {% if link.typeSymbol is not empty %}{{ link.typeSymbol }}{% else %}mixed{% endif %}> ${{ link.aPortSymbol }} */
${{ link.aPortSymbol }} = [];
/** @var array<int, {% if link.typeSymbol is not empty %}{{ link.typeSymbol }}{% else %}mixed{% endif %}> ${{ link.bPortSymbol }} */
${{ link.bPortSymbol }} = [];

function {{ link.transportSymbol }}(array &$a, array &$b): void
{
    if (count($a) > 0) {
        $b[] = array_shift($a);
    }
}
{% endif %}
