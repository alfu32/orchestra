{# A data link owns two FIFO buffers so processors can execute independently before the transport phase. #}
{% if link.stereotype == "DependencyInjection" %}const {{ link.dependencySymbol }} = {% if link.libraryInstantiation is not empty %}{{ link.libraryInstantiation }}{% else %}undefined{% endif %};
{% elseif link.stereotype != "UsageImport" %}/** @type {Array<{% if link.typeSymbol is not empty %}{{ link.typeSymbol }}{% else %}*{% endif %}>} */
const {{ link.aPortSymbol }} = [];
/** @type {Array<{% if link.typeSymbol is not empty %}{{ link.typeSymbol }}{% else %}*{% endif %}>} */
const {{ link.bPortSymbol }} = [];

function {{ link.transportSymbol }}(a, b) {
  if (a.length > 0) b.push(a.shift());
}
{% endif %}
