        },
        {
            "id": "node_059814d5-2184-47b6-93b0-f754589cf34f",
            "name": "gen_text",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce"
            ],
            "outgoingLinks": [
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5"
            ],
            "layout": {
                "x": 1263.666666666667,
                "y": 1071.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "static const char consonants[] = \"bcdfgklmnprstuvxz\";\nstatic const char vowels[] = \"aeiou\";\n\nif (ipWord == NULL) {\n    return;\n}\n\nint length = (int)ipUuid.random_word_length;\n\nif (length < 0) {\n    ipUuid.isok = false;\n    ipWord(ip_uuid);\n    return;\n}\n\nchar *word = malloc((size_t)length + 1);\n\nif (word == NULL) {\n    ipUuid.isok = false;\n    ipWord(ip_uuid);\n    return;\n}\n\nfor (int i = 0; i < length; ++i) {\n    if ((i % 2) == 0) {\n        word[i] = consonants[\n            rand() % (sizeof(consonants) - 1)\n        ];\n    } else {\n        word[i] = vowels[\n            rand() % (sizeof(vowels) - 1)\n        ];\n    }\n}\n\nword[length] = '\\0';\n\nipUuid.random_word = word;\n\nipWord(ipUuid);",
                "sourceLanguageId": "",
                "specification": "takes ipUuid and generates a random word string of length ipUuid.random_word_length that uses consonants and vowels from the dictionaries\n\nconsonants=\"bcdfgklmnprstuvxz\"\nvowels=\"aeiou\"\n\nalternating consonants with vowels and starting with a consonant\n\nfinally it pushes ipUuid to ipWord output",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-08-31T00:14:56.825179244Z",
                "user": "devlin"
            },
            "ports": [
                {
                    "id": "input_in",
                    "name": "in",
                    "direction": "Input",
                    "dataType": "",
                    "metadata": {}
                },
                {
                    "id": "output_out",
                    "name": "out",
                    "direction": "Output",
                    "dataType": "",
                    "metadata": {}
                }
            ],
            "link": null,
            "typeDefinition": null,
            "metadata": {},
            "pluginData": {}
        },
        {
            "id": "node_3b600a6f-96a5-42b4-beae-b74338ccf170",
            "name": "write_file",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5",
                "link_3f327a51-135b-4216-b55f-70ae41f06a30"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 1559.0,
                "y": 1204.0,
                "width": 220.0,
                "height": 108.0,
                "closedWidth": 220.0,
                "closedHeight": 108.0,
                "openWidth": 220.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "Packet item;\n\n\nif (pop(ip_word, &item) != THREADWORK_OK) {\n    return THREADWORK_ERROR;\n}\n\nFILE *file = fopen(\"ticker_out.csv\", \"a\");\nif (file == NULL) {\n    return THREADWORK_ERROR;\n}\n\nint fprintf_result = fprintf(\n    file,\n    \"\"%s\",\"%s\",\"%s\",%.0f,%s\\n\",\n    item.timestamp != NULL ? item.timestamp : \"\",\n    item.uuid != NULL ? item.uuid : \"\",\n    item.random_word != NULL ? item.random_word : \"\",\n    item.random_word_length,\n    item.isok ? \"true\" : \"false\"\n);\n\nif (fprintf_result < 0) {\n    fclose(file);\n    return THREADWORK_ERROR;\n}\n\nif (fclose(file) != 0) {\n    return THREADWORK_ERROR;\n}",
                "sourceLanguageId": "",
                "specification": "takes ipWord, serializes it as csv string and concatenates the result to the file \"ticker_out.csv\"",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-08-31T00:14:56.825179244Z",
                "user": "devlin"
