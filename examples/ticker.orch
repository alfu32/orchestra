            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#ifndef UUID_LIB_H\n#define UUID_LIB_H\n\n#include <uuid/uuid.h>\n#include <stdbool.h>\n#endif /* UUID_LIB_H */",
