        {
            "id": "node_bfbcce44-541d-4b63-94cf-c29411c15bb4",
            "name": "infinite_loop",
            "kind": "Processor",
            "parentId": "root",
            "children": [
                "node_a911c5c3-6366-4ba4-814a-1731b124ca66"
            ],
            "incomingLinks": [
                "link_a9fa5ad0-5571-4aba-9163-66a1e46c2fb1",
                "link_0b41dd34-a7c6-4dbd-a3ec-44c81f27ba24"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 291.0,
                "y": 1032.0,
                "width": 2496.0,
                "height": 721.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 2496.0,
                "openHeight": 721.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "\nsig_interceptor__sigaction_init();\n\nint status;\n\nstatus = tw_init_flow_9(context);\n\nif (status == THREADWORK_OK) {\n    while(running){\n            status = tw_run_flow_9(context);\n    }\n}\n\nusleep(5000);\nprintf(\"\\nexit sequence: beginning networ purge\\n\");\n\nif (status == THREADWORK_OK) {\n    network_purge__begin_shutdown(10U);\n  \n    while (network_purge__has_recent_transit() &&\n           status == THREADWORK_OK) {\n        status = tw_run_flow_9(context);\n    }\n}\n\nusleep(5000);\nprintf(\"\\nexit sequence: network purge ended\\n\");\nusleep(1000000);",
