        {
            "id": "node_627a3a3e-718f-4867-a71e-584b2d9b138b",
            "name": "gen_uuid",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_d1b9d286-d43a-439a-bee0-e66bf2943400",
                "link_a17dca3c-a162-4f7f-a264-abcd20c1f421"
            ],
            "outgoingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce"
            ],
            "layout": {
                "x": 908.6666666666665,
                "y": 1212.0,
                "width": 220.0,
                "height": 108.0,
                "closedWidth": 220.0,
                "closedHeight": 108.0,
                "openWidth": 220.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "Packet item;\nif (pop(ip_time, &item) != THREADWORK_OK) {\n    return THREADWORK_OK;\n}\n\nuuid_t uuid_value;\nchar *uuid_string = malloc(37);\n\nif (uuid_string == NULL) {\n    item.isok = false;\n    push(ip_uuid, &item);\n    return THREADWORK_ERROR;\n}\n\nuuids__uuid_generate_random(uuid_value);\nuuids__uuid_unparse_lower(uuid_value, uuid_string);\n\nitem.uuid = uuid_string;\nitem.random_word_length = 5 + (uuid_value[0] % 21);\nprintf(\"gen_text.timestamp:%s\\n\",item.timestamp != NULL ? item.timestamp : \"null\");\nprintf(\"gen_text.uuid:%s\\n\",item.uuid != NULL ? item.uuid : \"null\");\n\npush(ip_uuid, &item);",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_time, fills in its uuid field, sets random_word_length to a number between 5 and 25, and pushes the updated packet to ip_uuid",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
