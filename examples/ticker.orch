        {
            "id": "node_3b600a6f-96a5-42b4-beae-b74338ccf170",
            "name": "write_append_file",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_3f327a51-135b-4216-b55f-70ae41f06a30",
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5",
                "link_1a6bae84-65aa-43b8-b8f7-3fe067f296f8"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 1675.0,
                "y": 1223.0,
                "width": 220.0,
                "height": 108.0,
                "closedWidth": 220.0,
                "closedHeight": 108.0,
                "openWidth": 220.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "Packet item;\n\nchar *value;\nint sleepval=5000;\nint p = argslib__option(\"sleep\", &value);\nif(p>=0){\n    sleepval=atoi(value);\n}\nprintf(\"write_append_file.sleepvalue:%d\\n\",sleepval);\n\n\nif (pop(ip_word, &item) != THREADWORK_OK) {\n    return THREADWORK_OK;\n}\n\nFILE *file = fopen(\"ticker_out.csv\", \"a\");\nif (file == NULL) {\n    return THREADWORK_ERROR;\n}\n\nint fprintf_result = fprintf(\n    file,\n    \"\\\"%s\\\",\\\"%s\\\",\\\"%s\\\",%.0f,%s\\n\",\n    item.timestamp != NULL ? item.timestamp : \"\",\n    item.uuid != NULL ? item.uuid : \"\",\n    item.random_word != NULL ? item.random_word : \"\",\n    item.random_word_length,\n    item.isok ? \"true\" : \"false\"\n);\nprintf(\"write_append_file.timestamp:%s\\n\",item.timestamp != NULL ? item.timestamp : \"null\");\nprintf(\"write_append_file.uuid:%s\\n\",item.uuid != NULL ? item.uuid : \"null\");\nprintf(\"write_append_file.random_word:%s\\n\",item.random_word != NULL ? item.random_word : \"null\");\n\nif (fprintf_result < 0) {\n    fclose(file);\n    return THREADWORK_ERROR;\n}\n\nif (fclose(file) != 0) {\n    return THREADWORK_ERROR;\n}\n\nfree(item.timestamp);\n\nprintf(\"write_append_file.sleeping 5000 ns \\n\");\nusleep(sleepval);",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_word, serializes it as a CSV record, and appends the result to \"ticker_out.csv\"",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
