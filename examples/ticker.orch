        {
            "id": "node_627a3a3e-718f-4867-a71e-584b2d9b138b",
            "name": "gen_uuid",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_d1b9d286-d43a-439a-bee0-e66bf2943400",
                "link_a17dca3c-a162-4f7f-a264-abcd20c1f421"
            ],
            "outgoingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce"
            ],
            "layout": {
                "x": 1019.3333333333335,
                "y": 1210.0,
                "width": 220.0,
                "height": 108.0,
                "closedWidth": 220.0,
                "closedHeight": 108.0,
                "openWidth": 220.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "if (ipUuid == NULL) {\nreturn;\n}\n\nuuid_t uuid_value;\nchar *uuid_string = malloc(37);\n\nif (uuid_string == NULL) {\n    ip_time.isok = false;\n    ipUuid(ip_time);\n    return;\n}\n\nuuid_generate_random(uuid_value);\nuuid_unparse_lower(uuid_value, uuid_string);\n\nipTime.uuid = uuid_string;\nipTime.random_word_length = 5 + (uuid_value[0] % 21);\n\nip_uuid(ipTime);",
                "sourceLanguageId": "",
                "specification": "takes the ipTime and fills in the random_uuid field and also fills in the ip_time.random_word_length with a random number between 5 and 25\n\nfinally it pushes the ip_time packet to the output ipUuid",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-08-31T00:14:47.892147112Z",
                "user": "devlin"
            },
            "ports": [
                {
                    "id": "input_in",
                    "name": "in",
                    "direction": "Input",
                    "dataType": "",
                    "metadata": {}
                },
                {
                    "id": "output_out",
                    "name": "out",
                    "direction": "Output",
                    "dataType": "",
