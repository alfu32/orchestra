        {
            "id": "node_bfbcce44-541d-4b63-94cf-c29411c15bb4",
            "name": "infinite_loop",
            "kind": "Processor",
            "parentId": "root",
            "children": [
                "node_a911c5c3-6366-4ba4-814a-1731b124ca66"
            ],
            "incomingLinks": [
                "link_a9fa5ad0-5571-4aba-9163-66a1e46c2fb1"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 426.0,
                "y": 1013.0,
                "width": 1701.0,
                "height": 639.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 1701.0,
                "openHeight": 639.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "\nsig_interceptor__sigaction_init();\n\nint status;\n\nstatus = tw_init_flow_6(context);\n\nif (status == THREADWORK_OK) {\n    while(running){\n            status = tw_run_flow_6(context);\n    }\n}\n\nusleep(5000);\nprintf(\"exiting ...\\n\");\nusleep(1000000);",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
