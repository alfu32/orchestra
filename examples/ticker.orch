            "fileLayoutStrategyId": "single-file",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "tcc ticker.c -Wall -luuid -o ticker\n./ticker sleep 1000000\n\n# variant using the embedded tcc compiler\njava -jar threadworks.jar tinycc --launcher java exe ticker.c -luuid -o ticker\njavac -cp ../lib/tinycc-embed.jar TickerjLauncher.java\njava -cp .:threadworks.jar TickerjLauncher --sleep 1000000",
                "sourceLanguageId": "shellscript",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "shellscript",
                "technologyId": "file-export",
                "compilerId": "",
                "fileExtension": "",
