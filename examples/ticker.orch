                "source": "{# C continuous-runner override. #}\n\n{% if isCompilationRoot %}/* Generated by Threadwork's C17 compiler. */\n#include <stddef.h>\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <signal.h>\n#include <unistd.h>\n\n{{ runtimeSupport }}\n{% if hoistedDeclarations is not empty %}\n/* Modeled wire and domain types. */\n{{ hoistedDeclarations }}\n{% endif %}{% if forwardDeclarations is not empty %}\n/* Generated application prototypes. */\n{{ forwardDeclarations }}\n{% endif %}{% endif %}{% if inlineChildDeclarations is not empty %}\n/* Generated child definitions. */\n{{ inlineChildDeclarations }}\n{% endif %}\n/* Generated root definition. */\n{{ ownDeclaration }}\n{% if isCompilationRoot %}\n\nint main(void)\n{\n  threadwork_context context;\n  int status;\n\n  if (threadwork_context_init(&context) != THREADWORK_OK) {\n      return EXIT_FAILURE;\n  }\n\n  status = threadwork_install_shutdown_signal_handlers();\n  if (status == THREADWORK_OK) {\n      status = tw_{{ initializerSymbol }}(&context);\n  }\n\n  while (status == THREADWORK_OK && threadwork_running) {\n      status = tw_{{ runSymbol }}(&context);\n  }\n\n  if (status == THREADWORK_OK) {\n      threadwork_network_shutdown_begin(10U);\n      while (threadwork_network_has_recent_transit()) {\n          status = tw_{{ runSymbol }}(&context);\n          if (status != THREADWORK_OK) {\n              break;\n          }\n      }\n  }\n\n  threadwork_context_destroy(&context);\n  return status == THREADWORK_OK ? EXIT_SUCCESS : EXIT_FAILURE;\n}\n{% endif %}\n\n",
                "sourceLanguageId": "c",
                "specification": "• Create a compiler-template node named @CompositeSingleFile, set it to C / c-native, and place this in its Declaration editor:\n\n  {# C continuous-runner override. #}\n  {% if isCompilationRoot %}/* Generated by Threadwork's C17 compiler. */\n  #include <stddef.h>\n  #include <stdbool.h>\n  #include <stdint.h>\n  #include <stdio.h>\n  #include <stdlib.h>\n  #include <string.h>\n  #include <signal.h>\n  #include <unistd.h>\n\n  {{ runtimeSupport }}\n  {% if hoistedDeclarations is not empty %}\n  /* Modeled wire and domain types. */\n  {{ hoistedDeclarations }}\n  {% endif %}{% if forwardDeclarations is not empty %}\n  /* Generated application prototypes. */\n  {{ forwardDeclarations }}\n  {{ inlineChildDeclarations }}\n  {% endif %}\n  /* Generated root definition. */\n  {{ ownDeclaration }}\n  {% if isCompilationRoot %}\n\n  int main(void)\n  {\n      threadwork_context context;\n      int status;\n\n      if (threadwork_context_init(&context) != THREADWORK_OK) {\n          return EXIT_FAILURE;\n      }\n\n      status = threadwork_install_shutdown_signal_handlers();\n      if (status == THREADWORK_OK) {\n          status = tw_{{ initializerSymbol }}(&context);\n      }\n\n      while (status == THREADWORK_OK && threadwork_running) {\n          status = tw_{{ runSymbol }}(&context);\n      }\n\n      if (status == THREADWORK_OK) {\n          threadwork_network_shutdown_begin(10U);\n          while (threadwork_network_has_recent_transit()) {\n              status = tw_{{ runSymbol }}(&context);\n              if (status != THREADWORK_OK) {\n                  break;\n              }\n          }\n      }\n\n      threadwork_context_destroy(&context);\n      return status == THREADWORK_OK ? EXIT_SUCCESS : EXIT_FAILURE;\n  }\n  {% endif %}\n",
                "specificationLanguageId": "plain",
                "tests": "",
