        {
            "id": "node_d8909398-9b69-41a7-95b5-46a39e610544",
            "name": "sig_intercept_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_a9fa5ad0-5571-4aba-9163-66a1e46c2fb1"
            ],
            "layout": {
                "x": 747.6666666666667,
                "y": 924.0,
                "width": 200.0,
                "height": 78.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 200.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#include <stdio.h>\n#include <signal.h>\n#include <unistd.h>\n\nstatic volatile sig_atomic_t running = 1;\n\nstatic void handle_signal(int sig)\n{\n    (void)sig;\n    running = 0;\n}\n\nstruct sigaction sa = {\n    .sa_handler = handle_signal,\n    .sa_flags = 0\n};\n\nstatic void sigaction_init(){\n    sigemptyset(&sa.sa_mask);\n\n    sigaction(SIGINT,  &sa, NULL);   // Ctrl-C\n    sigaction(SIGTERM, &sa, NULL);   // kill / systemd stop\n}",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "A",
                "date": "20260831"
            },
            "responsible": null,
            "modified": {
                "date": "2026-09-01T10:21:29.932230865Z",
                "user": "devlin"
            },
            "ports": [
