        {
            "id": "node_82203592-4fed-4fd4-b0bf-9b02a90b0ad0",
            "name": "include_time_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_ecc22fe5-032c-4b24-812b-cc93b4ca76b0"
            ],
            "layout": {
                "x": 740.0,
                "y": 987.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#ifndef TIME_LIB_H\n#define TIME_LIB_H\n\n#include <stdbool.h>\n#include <stdio.h>\n#include <time.h>\n\n#endif /* TIME_LIB_H */",
                "sourceLanguageId": "",
                "specification": "creates a function that gets the system time and returns it as an int",
                "specificationLanguageId": "markdown",
                "tests": "",
