        {
            "id": "node_5f8d1854-0319-4d8a-a3d1-66161370dcad",
            "name": "network_purge_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_0b41dd34-a7c6-4dbd-a3ec-44c81f27ba24"
            ],
            "layout": {
                "x": 1898.0,
                "y": 935.0,
                "width": 200.0,
                "height": 78.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 200.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "  #include <stdbool.h>\n\n  /* Defined by this project's @RuntimeSupport override. */\nstatic unsigned long long network_purge_previous_transit = 0ULL;\nstatic unsigned int network_purge_idle_ticks = 0U;\nstatic unsigned int network_purge_remaining_ticks = 0U;\n\nvoid begin_shutdown(unsigned int idle_ticks)\n{\n    printf(\n        \"[begin_shutdown] ENTER \"\n        \"threadwork_transit=%llu \"\n        \"idle_ticks=%u\\n\",\n        threadwork_transit,\n        idle_ticks\n    );\n\n    network_purge_previous_transit = threadwork_transit;\n    network_purge_idle_ticks = idle_ticks;\n    network_purge_remaining_ticks = idle_ticks;\n\n    printf(\n        \"[begin_shutdown] SET \"\n        \"previous=%llu \"\n        \"idle=%u \"\n        \"remaining=%u\\n\",\n        network_purge_previous_transit,\n        network_purge_idle_ticks,\n        network_purge_remaining_ticks\n    );\n}\n\nint has_recent_transit(void)\n{\n    printf(\n        \"[has_recent_transit] ENTER \"\n        \"transit=%llu \"\n        \"previous=%llu \"\n        \"idle=%u \"\n        \"remaining=%u\\n\",\n        threadwork_transit,\n        network_purge_previous_transit,\n        network_purge_idle_ticks,\n        network_purge_remaining_ticks\n    );\n\n    if (threadwork_transit != network_purge_previous_transit) {\n\n        printf(\n            \"[has_recent_transit] TRANSIT DETECTED \"\n            \"%llu -> %llu\\n\",\n            network_purge_previous_transit,\n            threadwork_transit\n        );\n\n        network_purge_previous_transit = threadwork_transit;\n        network_purge_remaining_ticks = network_purge_idle_ticks;\n\n        printf(\n            \"[has_recent_transit] RESET remaining=%u, returning 1\\n\",\n            network_purge_remaining_ticks\n        );\n\n        return 1;\n    }\n\n    if (network_purge_remaining_ticks == 0U) {\n\n        printf(\n            \"[has_recent_transit] NO TRANSIT, remaining=0, returning 0\\n\"\n        );\n\n        return 0;\n    }\n\n    printf(\n        \"[has_recent_transit] NO TRANSIT, decrementing remaining \"\n        \"%u -> %u\\n\",\n        network_purge_remaining_ticks,\n        network_purge_remaining_ticks - 1U\n    );\n\n    network_purge_remaining_ticks--;\n\n    printf(\n        \"[has_recent_transit] returning 1, remaining=%u\\n\",\n        network_purge_remaining_ticks\n    );\n\n    return 1;\n}\n",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
