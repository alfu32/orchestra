        {
            "id": "node_059814d5-2184-47b6-93b0-f754589cf34f",
            "name": "gen_text",
            "kind": "Processor",
            "parentId": "node_a911c5c3-6366-4ba4-814a-1731b124ca66",
            "children": [],
            "incomingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce"
            ],
            "outgoingLinks": [
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5"
            ],
            "layout": {
                "x": 1688.3333333333333,
                "y": 1439.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "static const char consonants[] = \"bcdfgklmnprstuvxz\";\nstatic const char vowels[] = \"aeiou\";\n\nPacket item;\nif (pop(ip_uuid, &item) != THREADWORK_OK) {\n    return THREADWORK_OK;\n}\n\nint length = (int)item.random_word_length;\n\nif (length < 0) {\n    item.isok = false;\n    push(ip_word, &item);\n    return THREADWORK_ERROR;\n}\n\nchar *word = malloc((size_t)length + 1);\n\nif (word == NULL) {\n    item.isok = false;\n    push(ip_word, &item);\n    return THREADWORK_ERROR;\n}\n\nfor (int i = 0; i < length; ++i) {\n    if ((i % 2) == 0) {\n        word[i] = consonants[\n            rand() % (sizeof(consonants) - 1)\n        ];\n    } else {\n        word[i] = vowels[\n            rand() % (sizeof(vowels) - 1)\n        ];\n    }\n}\n\nword[length] = '\\0';\n\nitem.random_word = word;\nprintf(\"gen_text.timestamp:%s\\n\",item.timestamp != NULL ? item.timestamp : \"null\");\nprintf(\"gen_text.uuid:%s\\n\",item.uuid != NULL ? item.uuid : \"null\");\nprintf(\"gen_text.random_word:%s\\n\",item.random_word != NULL ? item.random_word : \"null\");\n\npush(ip_word, &item);",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_uuid and generates a random word string of length random_word_length using the dictionaries\n\nconsonants=\"bcdfgklmnprstuvxz\"\nvowels=\"aeiou\"\n\nalternating consonants with vowels and starting with a consonant\n\nfinally it pushes the updated Packet to ip_word",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "A",
                "date": "20260831"
            },
            "responsible": null,
            "modified": {
                "date": "2026-09-01T09:45:27.658504672Z",
                "user": "devlin"
            },
